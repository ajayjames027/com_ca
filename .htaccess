<IfModule mod_rewrite.c>
RewriteEngine On

# Allow direct access to existing static files & folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Direct API endpoint rewrites for high performance
RewriteRule ^api/register/?$ api/register.php [L,QSA]
RewriteRule ^api/login/?$ api/login.php [L,QSA]
RewriteRule ^api/team/status/(.+)$ api/team_status.php?teamName=$1 [L,QSA]
RewriteRule ^api/admin/teams/?$ api/admin_teams.php [L,QSA]
RewriteRule ^api/admin/approve/([0-9]+)$ api/admin_approve.php?id=$1 [L,QSA]
RewriteRule ^api/admin/reject/([0-9]+)$ api/admin_reject.php?id=$1 [L,QSA]
RewriteRule ^api/admin/team/([0-9]+)$ api/admin_delete.php?id=$1 [L,QSA]
RewriteRule ^api/admin/export-csv/?$ api/export_csv.php [L,QSA]

# Fallback API router
RewriteRule ^api/(.*)$ api/index.php [L,QSA]
</IfModule>

# Protect sensitive database & config files from web access
<FilesMatch "^(\.env|config\.php|schema\.sql|hackfest\.db|\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory indexing
Options -Indexes

# Default landing page
DirectoryIndex index.html index.php
